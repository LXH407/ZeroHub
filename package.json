{
  "name": "zero-hub-software-mall",
  "version": "1.0.0",
  "description": "ZeroHub软件商城系统 - 包含API中转站、大模型、软件、游戏下载平台",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix admin-web install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
